# Recording Configuration Example
#
# install.sh seeds this to <prefix>/etc/record.toml (default
# /opt/save_audio_stream/etc/record.toml) and never overwrites it afterwards,
# so edits here survive upgrades. Run with an explicit path via `-c` to use a
# different one.

config_type = 'record'

# Global settings

# Where recordings, their SQLite databases and their lock files go. Commented
# out because the default is already the right answer on an installed system:
# <prefix>/data/recordings — a sibling of versions/, so upgrades, pruning and
# rollback never touch it. A relative path is resolved against the working
# directory, which is rarely what a service wants.
# output_dir = '/opt/save_audio_stream/data/recordings'

api_port = 17000             # API server port (required for sync)

[[sessions]]
url = 'https://stream.example.com/radio'
name = 'myradio'

# Optional settings (with defaults)
audio_format = 'opus'       # Options: opus, aac, wav
bitrate = 24                # kbps (default: 32 for AAC, 16 for Opus)
split_interval = 300        # Split chunks every N seconds (0 = no split)
retention_hours = 72        # Auto-delete recordings older than N hours (default: 168)

# Schedule: when to record (UTC times)
[sessions.schedule]
record_start = '14:00'
record_end = '16:00'

# Add more sessions as needed
[[sessions]]
url = 'https://stream2.example.com/radio'
name = 'myradio2'

[sessions.schedule]
record_start = '18:00'
record_end = '20:00'
